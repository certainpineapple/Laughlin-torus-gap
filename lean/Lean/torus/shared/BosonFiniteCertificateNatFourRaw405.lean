theorem f405_raw_M4_matrix_check : ∀ a b : Fin 6,
    natFourCachedGramForm f405sourceGramCache (f405basis a) (f405basis b)=f405rawM4Form a b := by
  intro a b
  fin_cases a <;> fin_cases b <;> decide +kernel


theorem f405_actual_raw_M4_matrix (x y : Fin 6 → ℂ) :
    natOccupationInner (natFourWordBlock f405basis x)
      (canonicalNatFourOriginalOperator (natFourWordBlock f405basis y)) =
      star x ⬝ᵥ (complexify f405rawM4Form *ᵥ y) := by
  have hshape (a : Fin 6) :
      (f405basis a).length=4 ∧ (f405basis a).sum=5 := by
    apply natFourBasis_shape 5
    rw [← f405_basis_enumeration]
    exact List.mem_ofFn.mpr ⟨a,rfl⟩
  exact canonicalNatFourOriginalOperator_cached_matrix_form 5 f405basis
    (fun a => (hshape a).1) (fun a => (hshape a).2) f405activePairs
    f405_active_pairs_source_check f405sourceGramCache
    f405_source_gram_cache_check f405rawM4Form f405_raw_M4_matrix_check x y


#print axioms f405_raw_M4_matrix_check
#print axioms f405_actual_raw_M4_matrix
