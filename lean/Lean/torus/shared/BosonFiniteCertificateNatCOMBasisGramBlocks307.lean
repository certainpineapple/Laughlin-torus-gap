/-- The original relative-column label, including its precise dependent fiber. -/
def k307COMLabel9 (i : Fin 8) : NatCOMRelativeLabel :=
  ⟨k307COMRelativeDegree i,(k307COMIndexLabel i).2⟩

private theorem k307_COM_gram_labelled_rat :
    k307COMBasisᵀ * k307fullGram * k307COMBasis =
      fun i j => natCOMDescendantGramEntry 7 (k307COMLabel9 i) (k307COMLabel9 j) := by
  decide +kernel

private theorem k307_COM_dual_labelled_rat :
    k307COMBasisInverse * p307Ginv * k307COMBasisInverseᵀ =
      fun i j => natCOMDescendantDualEntry 7 (k307COMLabel9 i) (k307COMLabel9 j) := by
  decide +kernel

/-- True Gram block scales are 3^n n!, with no normalization of the source family. -/
theorem k307_COM_gram_labelled :
    k307COMGram = complexify
      (fun i j => natCOMDescendantGramEntry 7 (k307COMLabel9 i) (k307COMLabel9 j)) := by
  unfold k307COMGram
  rw [← complexify_transpose_rect,← complexify_mul_rect,← complexify_mul_rect,
    k307_COM_gram_labelled_rat]

/-- The true inverse Gram has inverse 3^n n! scales on the original relative duals. -/
theorem k307_COM_dual_labelled :
    k307COMGramInverse = complexify
      (fun i j => natCOMDescendantDualEntry 7 (k307COMLabel9 i) (k307COMLabel9 j)) := by
  unfold k307COMGramInverse
  rw [← complexify_transpose_rect,← complexify_mul_rect,← complexify_mul_rect,
    k307_COM_dual_labelled_rat]

/-- Rational coordinates of the genuine rank coefficient, retaining the full source matrix. -/
def k307COMRankCoefficientRat : Matrix (Fin 8) (Fin 8) ℚ :=
  (k307COMBasisInverse * p307Ginv * k307COMBasisInverseᵀ) *
    (k307COMBasisᵀ * p307Mform * k307COMBasis) *
    (k307COMBasisInverse * p307Ginv * k307COMBasisInverseᵀ)

theorem k307_COM_rank_coefficient_rat :
    k307COMRankCoefficient = complexify k307COMRankCoefficientRat := by
  simp only [k307COMRankCoefficient,k307COMRankCoefficientRat,inverseGramCoefficient,
    k307COMGramInverse,k307COMSourceForm,k307_actual_M3_reconstructed,
    complexify_mul_rect,complexify_transpose_rect]

