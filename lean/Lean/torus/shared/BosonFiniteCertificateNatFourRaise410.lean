theorem f410_rational_raise_check : ∀ a : Fin 23,
    natFourRationalRaiseWord (f410basis a) =
      ∑ b : Fin 27, f410raise b a • (wordPolynomial (f411basis b) : Core ℕ ℚ) := by
  have hc : ∀ b a, (f410raiseNat b a : ℚ)=f410raise b a :=
    natFourRationalEntryCheck_sound (fun b a => (f410raiseNat b a : ℚ))
      f410raise (by decide +kernel)
  have hp : ∀ a : Fin 23, (natFourExpandedWords ((raisedWordsNat (f410basis a)).map fun w => (1,w))).Perm
      (natFourExpandedWords (List.ofFn fun b => (f410raiseNat b a,f411basis b))) := by
    intro a
    simp only [natFourExpandedWords,natFourSortedWord,List.mergeSort_eq_insertionSort]
    fin_cases a <;> decide +kernel
  intro a
  simpa only [hc] using natFour_raise_rational_of_expanded_perm
    (f410basis a) f411basis (fun b => f410raiseNat b a) (hp a)

theorem f410_actual_raise_word (a : Fin 23) :
    canonicalCOMRaiseNat (scaledWord factorialRootNat (f410basis a)) =
      ∑ b : Fin 27, (f410raise b a : ℂ) • scaledWord factorialRootNat (f411basis b) :=
  natFour_raise_action_of_rational_check (f410basis a) f411basis
    (fun b => f410raise b a) (f410_rational_raise_check a)

theorem f410_actual_raise_block (v : Fin 23 → ℂ) :
    canonicalCOMRaiseNat (natFourWordBlock f410basis v) =
      natFourWordBlock f411basis (complexify f410raise *ᵥ v) :=
  natFourWordBlock_rect_action f410basis f411basis canonicalCOMRaiseNat
    (complexify f410raise) f410_actual_raise_word v

