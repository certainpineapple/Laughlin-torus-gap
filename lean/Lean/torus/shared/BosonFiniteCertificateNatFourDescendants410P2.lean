theorem f410desc2_compression_check :
    f410desc2ᵀ*f412rawM4Form*f410desc2=f410desc2Form := by
  have hD : natFourIntegerMatrix 1260 f410desc2IntegerCoordinates=f410desc2 := by
    ext a b
    exact natFourRationalEntryCheck_sound (natFourIntegerMatrix 1260 f410desc2IntegerCoordinates) (f410desc2) (by decide +kernel) a b
  have hV : f410desc2IntegerCoordinatesᵀ*f412rawInteger=f410desc2IntegerLeftProduct := by
    ext a b
    fin_cases a
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 34) => (f410desc2IntegerCoordinatesᵀ*f412rawInteger) 0 j)
        (fun (_ : Fin 1) (j : Fin 34) => (f410desc2IntegerLeftProduct) 0 j) (by decide +kernel)
      exact congrFun (congrFun h 0) b
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 34) => (f410desc2IntegerCoordinatesᵀ*f412rawInteger) 1 j)
        (fun (_ : Fin 1) (j : Fin 34) => (f410desc2IntegerLeftProduct) 1 j) (by decide +kernel)
      exact congrFun (congrFun h 0) b
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 34) => (f410desc2IntegerCoordinatesᵀ*f412rawInteger) 2 j)
        (fun (_ : Fin 1) (j : Fin 34) => (f410desc2IntegerLeftProduct) 2 j) (by decide +kernel)
      exact congrFun (congrFun h 0) b
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 34) => (f410desc2IntegerCoordinatesᵀ*f412rawInteger) 3 j)
        (fun (_ : Fin 1) (j : Fin 34) => (f410desc2IntegerLeftProduct) 3 j) (by decide +kernel)
      exact congrFun (congrFun h 0) b
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 34) => (f410desc2IntegerCoordinatesᵀ*f412rawInteger) 4 j)
        (fun (_ : Fin 1) (j : Fin 34) => (f410desc2IntegerLeftProduct) 4 j) (by decide +kernel)
      exact congrFun (congrFun h 0) b
  have hY : f410desc2IntegerLeftProduct*f410desc2IntegerCoordinates=f410desc2IntegerForm := by
    ext a b
    fin_cases a
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 5) => (f410desc2IntegerLeftProduct*f410desc2IntegerCoordinates) 0 j)
        (fun (_ : Fin 1) (j : Fin 5) => (f410desc2IntegerForm) 0 j) (by decide +kernel)
      exact congrFun (congrFun h 0) b
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 5) => (f410desc2IntegerLeftProduct*f410desc2IntegerCoordinates) 1 j)
        (fun (_ : Fin 1) (j : Fin 5) => (f410desc2IntegerForm) 1 j) (by decide +kernel)
      exact congrFun (congrFun h 0) b
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 5) => (f410desc2IntegerLeftProduct*f410desc2IntegerCoordinates) 2 j)
        (fun (_ : Fin 1) (j : Fin 5) => (f410desc2IntegerForm) 2 j) (by decide +kernel)
      exact congrFun (congrFun h 0) b
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 5) => (f410desc2IntegerLeftProduct*f410desc2IntegerCoordinates) 3 j)
        (fun (_ : Fin 1) (j : Fin 5) => (f410desc2IntegerForm) 3 j) (by decide +kernel)
      exact congrFun (congrFun h 0) b
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 5) => (f410desc2IntegerLeftProduct*f410desc2IntegerCoordinates) 4 j)
        (fun (_ : Fin 1) (j : Fin 5) => (f410desc2IntegerForm) 4 j) (by decide +kernel)
      exact congrFun (congrFun h 0) b
  have hF : natFourIntegerMatrix (1260*1000000000000000000000000*1260) f410desc2IntegerForm=f410desc2Form := by
