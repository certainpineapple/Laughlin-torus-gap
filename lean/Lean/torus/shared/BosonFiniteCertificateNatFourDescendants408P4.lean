theorem f408desc4_compression_check :
    f408desc4ᵀ*f412rawM4Form*f408desc4=f408desc4Form := by
  have hD : natFourIntegerMatrix 210 f408desc4IntegerCoordinates=f408desc4 := by
    ext a b
    exact natFourRationalEntryCheck_sound (natFourIntegerMatrix 210 f408desc4IntegerCoordinates) (f408desc4) (by decide +kernel) a b
  have hV : f408desc4IntegerCoordinatesᵀ*f412rawInteger=f408desc4IntegerLeftProduct := by
    ext a b
    fin_cases a
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 34) => (f408desc4IntegerCoordinatesᵀ*f412rawInteger) 0 j)
        (fun (_ : Fin 1) (j : Fin 34) => (f408desc4IntegerLeftProduct) 0 j) (by decide +kernel)
      exact congrFun (congrFun h 0) b
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 34) => (f408desc4IntegerCoordinatesᵀ*f412rawInteger) 1 j)
        (fun (_ : Fin 1) (j : Fin 34) => (f408desc4IntegerLeftProduct) 1 j) (by decide +kernel)
      exact congrFun (congrFun h 0) b
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 34) => (f408desc4IntegerCoordinatesᵀ*f412rawInteger) 2 j)
        (fun (_ : Fin 1) (j : Fin 34) => (f408desc4IntegerLeftProduct) 2 j) (by decide +kernel)
      exact congrFun (congrFun h 0) b
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 34) => (f408desc4IntegerCoordinatesᵀ*f412rawInteger) 3 j)
        (fun (_ : Fin 1) (j : Fin 34) => (f408desc4IntegerLeftProduct) 3 j) (by decide +kernel)
      exact congrFun (congrFun h 0) b
  have hY : f408desc4IntegerLeftProduct*f408desc4IntegerCoordinates=f408desc4IntegerForm := by
    ext a b
    fin_cases a
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 4) => (f408desc4IntegerLeftProduct*f408desc4IntegerCoordinates) 0 j)
        (fun (_ : Fin 1) (j : Fin 4) => (f408desc4IntegerForm) 0 j) (by decide +kernel)
      exact congrFun (congrFun h 0) b
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 4) => (f408desc4IntegerLeftProduct*f408desc4IntegerCoordinates) 1 j)
        (fun (_ : Fin 1) (j : Fin 4) => (f408desc4IntegerForm) 1 j) (by decide +kernel)
      exact congrFun (congrFun h 0) b
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 4) => (f408desc4IntegerLeftProduct*f408desc4IntegerCoordinates) 2 j)
        (fun (_ : Fin 1) (j : Fin 4) => (f408desc4IntegerForm) 2 j) (by decide +kernel)
      exact congrFun (congrFun h 0) b
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 4) => (f408desc4IntegerLeftProduct*f408desc4IntegerCoordinates) 3 j)
        (fun (_ : Fin 1) (j : Fin 4) => (f408desc4IntegerForm) 3 j) (by decide +kernel)
      exact congrFun (congrFun h 0) b
  have hF : natFourIntegerMatrix (210*1000000000000000000000000*210) f408desc4IntegerForm=f408desc4Form := by
    ext a b
    exact natFourRationalEntryCheck_sound (natFourIntegerMatrix (210*1000000000000000000000000*210) f408desc4IntegerForm) (f408desc4Form) (by decide +kernel) a b
  exact natFourIntegerMatrix_compression_check_staged 1000000000000000000000000 210
    f412rawInteger f408desc4IntegerCoordinates f408desc4IntegerLeftProduct f408desc4IntegerForm
    f412rawM4Form f408desc4 f408desc4Form f412_raw_integer_check hD hV hY hF

