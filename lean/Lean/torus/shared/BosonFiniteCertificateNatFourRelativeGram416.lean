theorem f416_relative_gram_check :
    b416relativeᵀ*natFourWordGram f416basis*b416relative=f416relativeGram := by
  have hG : natFourWordGram f416basis=Matrix.diagonal (fun a => (f416wordMetric a : ℚ)) := by
    unfold natFourWordGram
    congr 1
    funext a
    rw [f416_word_metric_check]
  rw [hG]
  have hU : natFourIntegerMatrix 180180 f416GramIntegerCoordinates=b416relative := by
    ext i j
    exact natFourRationalEntryCheck_sound _ _ (by decide +kernel) i j
  have hY : ∀ i j, (∑ a : Fin 64, f416GramIntegerCoordinates a i*(f416wordMetric a : ℤ)*
      f416GramIntegerCoordinates a j)=f416GramIntegerForm i j := by
    intro i j
    fin_cases i
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 10) => ∑ a : Fin 64, f416GramIntegerCoordinates a 0*
          (f416wordMetric a : ℤ)*f416GramIntegerCoordinates a j)
        (fun (_ : Fin 1) (j : Fin 10) => f416GramIntegerForm 0 j) (by decide +kernel)
      exact congrFun (congrFun h 0) j
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 10) => ∑ a : Fin 64, f416GramIntegerCoordinates a 1*
          (f416wordMetric a : ℤ)*f416GramIntegerCoordinates a j)
        (fun (_ : Fin 1) (j : Fin 10) => f416GramIntegerForm 1 j) (by decide +kernel)
      exact congrFun (congrFun h 0) j
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 10) => ∑ a : Fin 64, f416GramIntegerCoordinates a 2*
          (f416wordMetric a : ℤ)*f416GramIntegerCoordinates a j)
        (fun (_ : Fin 1) (j : Fin 10) => f416GramIntegerForm 2 j) (by decide +kernel)
      exact congrFun (congrFun h 0) j
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 10) => ∑ a : Fin 64, f416GramIntegerCoordinates a 3*
          (f416wordMetric a : ℤ)*f416GramIntegerCoordinates a j)
        (fun (_ : Fin 1) (j : Fin 10) => f416GramIntegerForm 3 j) (by decide +kernel)
      exact congrFun (congrFun h 0) j
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 10) => ∑ a : Fin 64, f416GramIntegerCoordinates a 4*
          (f416wordMetric a : ℤ)*f416GramIntegerCoordinates a j)
        (fun (_ : Fin 1) (j : Fin 10) => f416GramIntegerForm 4 j) (by decide +kernel)
      exact congrFun (congrFun h 0) j
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 10) => ∑ a : Fin 64, f416GramIntegerCoordinates a 5*
          (f416wordMetric a : ℤ)*f416GramIntegerCoordinates a j)
        (fun (_ : Fin 1) (j : Fin 10) => f416GramIntegerForm 5 j) (by decide +kernel)
      exact congrFun (congrFun h 0) j
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 10) => ∑ a : Fin 64, f416GramIntegerCoordinates a 6*
          (f416wordMetric a : ℤ)*f416GramIntegerCoordinates a j)
        (fun (_ : Fin 1) (j : Fin 10) => f416GramIntegerForm 6 j) (by decide +kernel)
      exact congrFun (congrFun h 0) j
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 10) => ∑ a : Fin 64, f416GramIntegerCoordinates a 7*
          (f416wordMetric a : ℤ)*f416GramIntegerCoordinates a j)
        (fun (_ : Fin 1) (j : Fin 10) => f416GramIntegerForm 7 j) (by decide +kernel)
      exact congrFun (congrFun h 0) j
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 10) => ∑ a : Fin 64, f416GramIntegerCoordinates a 8*
          (f416wordMetric a : ℤ)*f416GramIntegerCoordinates a j)
        (fun (_ : Fin 1) (j : Fin 10) => f416GramIntegerForm 8 j) (by decide +kernel)
      exact congrFun (congrFun h 0) j
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 10) => ∑ a : Fin 64, f416GramIntegerCoordinates a 9*
          (f416wordMetric a : ℤ)*f416GramIntegerCoordinates a j)
        (fun (_ : Fin 1) (j : Fin 10) => f416GramIntegerForm 9 j) (by decide +kernel)
      exact congrFun (congrFun h 0) j
  have hF : natFourIntegerMatrix (180180*180180) f416GramIntegerForm=f416relativeGram := by
    ext i j
    exact natFourRationalEntryCheck_sound _ _ (by decide +kernel) i j
  exact natFour_integer_weighted_compression_check 180180 f416wordMetric
    f416GramIntegerCoordinates f416GramIntegerForm b416relative f416relativeGram hU hY hF

theorem f416_actual_relative_gram :
    natFamilyGram f416relativeFamily=complexify f416relativeGram := by
  rw [f416relativeFamily,natFourColumnFamily_gram f416basis f416_occupation_injective,
    f416_relative_gram_check]

theorem f416_relative_gram_inverse_right :
    f416relativeGram*f416relativeGramInverse=1 := by
  ext i j
  exact natFourRationalEntryCheck_sound _ _ (by decide +kernel) i j

theorem f416_relative_gram_inverse_left :
    f416relativeGramInverse*f416relativeGram=1 := by
  ext i j
  exact natFourRationalEntryCheck_sound _ _ (by decide +kernel) i j

theorem f416_relative_gram_inverse_symmetric :
    f416relativeGramInverseᵀ=f416relativeGramInverse := by
  ext i j
  exact natFourRationalEntryCheck_sound _ _ (by decide +kernel) i j

