theorem f408_raw_M4_matrix_check : ∀ a b : Fin 15,
    natFourFactorizedCachedGramForm (f408sourceRowCache a) (f408basis a) (f408basis b)=f408rawM4Form a b := by
  intro a b
  have hshape (i : Fin 15) : (f408basis i).length=4 ∧ (f408basis i).sum=8 := by
    apply natFourBasis_shape 8
    rw [← f408_basis_enumeration]
    exact List.mem_ofFn.mpr ⟨i,rfl⟩
  have hdegree := natFourSourceCache_degree 8 f408activePairs
    f408_active_pairs_source_check f408sourceGramCache f408_source_gram_cache_check
  have hrow : ∀ t : Fin 4, ∀ entry ∈ f408sourceRowCache a t.val,
      natFourCacheDegreeCompatible 8 t.val entry=true := by
    intro t entry he
    rw [f408_source_row_cache_check a t.val] at he
    exact natFourSourceRowCache_degree 8 f408sourceGramCache hdegree (f408basis a) t entry he
  rw [←natFourPrefixCollapsedForm_eq 8 (f408sourceRowCache a) hrow _ _
    (hshape a).1 (hshape b).1 (hshape a).2 (hshape b).2]
  fin_cases a
  · exact f408_source_row_0 b
  · exact f408_source_row_1 b
  · exact f408_source_row_2 b
  · exact f408_source_row_3 b
  · exact f408_source_row_4 b
  · exact f408_source_row_5 b
  · exact f408_source_row_6 b
  · exact f408_source_row_7 b
  · exact f408_source_row_8 b
  · exact f408_source_row_9 b
  · exact f408_source_row_10 b
  · exact f408_source_row_11 b
  · exact f408_source_row_12 b
  · exact f408_source_row_13 b
  · exact f408_source_row_14 b


theorem f408_actual_raw_M4_matrix (x y : Fin 15 → ℂ) :
    natOccupationInner (natFourWordBlock f408basis x)
      (canonicalNatFourOriginalOperator (natFourWordBlock f408basis y)) =
      star x ⬝ᵥ (complexify f408rawM4Form *ᵥ y) := by
  have hshape (a : Fin 15) :
      (f408basis a).length=4 ∧ (f408basis a).sum=8 := by
    apply natFourBasis_shape 8
    rw [← f408_basis_enumeration]
    exact List.mem_ofFn.mpr ⟨a,rfl⟩
  exact canonicalNatFourOriginalOperator_row_cached_matrix_form 8 f408basis
    (fun a => (hshape a).1) (fun a => (hshape a).2) f408activePairs
    f408_active_pairs_source_check f408sourceGramCache
    f408_source_gram_cache_check f408sourceRowCache
    f408_source_row_cache_check f408rawM4Form f408_raw_M4_matrix_check x y


