/-- The original relative-column label, including its precise dependent fiber. -/
def k308COMLabel9 (i : Fin 10) : NatCOMRelativeLabel :=
  ⟨k308COMRelativeDegree i,(k308COMIndexLabel i).2⟩

private theorem k308_COM_gram_labelled_rat :
    k308COMBasisᵀ * k308fullGram * k308COMBasis =
      fun i j => natCOMDescendantGramEntry 8 (k308COMLabel9 i) (k308COMLabel9 j) := by
  decide +kernel

private theorem k308_COM_dual_labelled_rat :
    k308COMBasisInverse * p308Ginv * k308COMBasisInverseᵀ =
      fun i j => natCOMDescendantDualEntry 8 (k308COMLabel9 i) (k308COMLabel9 j) := by
  decide +kernel

/-- True Gram block scales are 3^n n!, with no normalization of the source family. -/
theorem k308_COM_gram_labelled :
    k308COMGram = complexify
      (fun i j => natCOMDescendantGramEntry 8 (k308COMLabel9 i) (k308COMLabel9 j)) := by
  unfold k308COMGram
  rw [← complexify_transpose_rect,← complexify_mul_rect,← complexify_mul_rect,
    k308_COM_gram_labelled_rat]

/-- The true inverse Gram has inverse 3^n n! scales on the original relative duals. -/
theorem k308_COM_dual_labelled :
    k308COMGramInverse = complexify
      (fun i j => natCOMDescendantDualEntry 8 (k308COMLabel9 i) (k308COMLabel9 j)) := by
  unfold k308COMGramInverse
  rw [← complexify_transpose_rect,← complexify_mul_rect,← complexify_mul_rect,
    k308_COM_dual_labelled_rat]

/-- Rational coordinates of the genuine rank coefficient, retaining the full source matrix. -/
def k308COMRankCoefficientRat : Matrix (Fin 10) (Fin 10) ℚ :=
  (k308COMBasisInverse * p308Ginv * k308COMBasisInverseᵀ) *
    (k308COMBasisᵀ * p308Mform * k308COMBasis) *
    (k308COMBasisInverse * p308Ginv * k308COMBasisInverseᵀ)

theorem k308_COM_rank_coefficient_rat :
    k308COMRankCoefficient = complexify k308COMRankCoefficientRat := by
  simp only [k308COMRankCoefficient,k308COMRankCoefficientRat,inverseGramCoefficient,
    k308COMGramInverse,k308COMSourceForm,k308_actual_M3_reconstructed,
    complexify_mul_rect,complexify_transpose_rect]

