def b414comparison : Matrix (Fin 8) (Fin 8) ℚ :=
  (alpha) • b414s - b414average + delta • b414h

theorem b414_comparison_reconstruction :
    b414comparison = b414E := by decide +kernel

theorem b414_factor_acceptance :
    TorusLean.M2.rationalPSDCheck b414E b414L b414pivots = true := by decide +kernel

theorem b414_hamiltonian_factor_acceptance :
    TorusLean.M2.rationalPSDCheck b414h b414hL b414hPivots = true := by decide +kernel

theorem b414_relative_annihilated :
    b414lower * b414relative = 0 := by decide +kernel

theorem b414_relative_left_inverse :
    b414free * b414relative = 1 := by decide +kernel

theorem b414_relative_complete :
    b414relative * b414free + b414split * b414lower = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;> decide +kernel

theorem b414_kernel_annihilated :
    b414h * b414null = 0 := by decide +kernel

theorem b414_kernel_left_inverse :
    b414nullFree * b414null = 1 := by decide +kernel

theorem b414_kernel_complete :
    b414null * b414nullFree + b414nullSplit * b414h = 1 := by decide +kernel

theorem b414_kernel_preserved :
    b414E * b414null = 0 := by decide +kernel

theorem b414_comparison_positive :
    (TorusLean.M2.complexify b414comparison).PosSemidef := by
  rw [b414_comparison_reconstruction]
  exact TorusLean.M2.rationalPSDCheck_sound _ _ _ b414_factor_acceptance

theorem b414_relative_exact (v : Fin 47 → ℚ) :
    b414lower *ᵥ v = 0 ↔ ∃ x : Fin 8 → ℚ, b414relative *ᵥ x = v :=
