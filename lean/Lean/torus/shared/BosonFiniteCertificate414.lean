    b414_relative_annihilated b414_relative_complete v

theorem b414_zero_kernel_preserved (v : Fin 8 → ℚ)
    (hv : b414h *ᵥ v = 0) : b414comparison *ᵥ v = 0 := by
  rw [b414_comparison_reconstruction]
  exact kernel_preserved_from_split b414h b414E b414null
    b414nullFree b414nullSplit b414_kernel_complete
    b414_kernel_preserved v hv

