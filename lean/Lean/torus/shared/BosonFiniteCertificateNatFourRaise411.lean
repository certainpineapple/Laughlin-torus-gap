theorem f411_rational_raise_check : ∀ a : Fin 27,
    natFourRationalRaiseWord (f411basis a) =
      ∑ b : Fin 34, f411raise b a • (wordPolynomial (f412basis b) : Core ℕ ℚ) := by
  have hc : ∀ b a, (f411raiseNat b a : ℚ)=f411raise b a :=
    natFourRationalEntryCheck_sound (fun b a => (f411raiseNat b a : ℚ))
      f411raise (by decide +kernel)
  have hp : ∀ a : Fin 27, (natFourExpandedWords ((raisedWordsNat (f411basis a)).map fun w => (1,w))).Perm
      (natFourExpandedWords (List.ofFn fun b => (f411raiseNat b a,f412basis b))) := by
    intro a
    simp only [natFourExpandedWords,natFourSortedWord,List.mergeSort_eq_insertionSort]
    fin_cases a <;> decide +kernel
  intro a
  simpa only [hc] using natFour_raise_rational_of_expanded_perm
    (f411basis a) f412basis (fun b => f411raiseNat b a) (hp a)

theorem f411_actual_raise_word (a : Fin 27) :
    canonicalCOMRaiseNat (scaledWord factorialRootNat (f411basis a)) =
      ∑ b : Fin 34, (f411raise b a : ℂ) • scaledWord factorialRootNat (f412basis b) :=
  natFour_raise_action_of_rational_check (f411basis a) f412basis
    (fun b => f411raise b a) (f411_rational_raise_check a)

theorem f411_actual_raise_block (v : Fin 27 → ℂ) :
    canonicalCOMRaiseNat (natFourWordBlock f411basis v) =
      natFourWordBlock f412basis (complexify f411raise *ᵥ v) :=
  natFourWordBlock_rect_action f411basis f412basis canonicalCOMRaiseNat
    (complexify f411raise) f411_actual_raise_word v

