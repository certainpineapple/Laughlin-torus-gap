def b412comparison : Matrix (Fin 7) (Fin 7) ℚ :=
  (alpha) • b412s - b412average + delta • b412h

theorem b412_comparison_reconstruction :
    b412comparison = b412E := by decide +kernel

theorem b412_factor_acceptance :
    TorusLean.M2.rationalPSDCheck b412E b412L b412pivots = true := by decide +kernel

theorem b412_hamiltonian_factor_acceptance :
    TorusLean.M2.rationalPSDCheck b412h b412hL b412hPivots = true := by decide +kernel

theorem b412_relative_annihilated :
    b412lower * b412relative = 0 := by decide +kernel

theorem b412_relative_left_inverse :
    b412free * b412relative = 1 := by decide +kernel

theorem b412_relative_complete :
    b412relative * b412free + b412split * b412lower = 1 := by decide +kernel

theorem b412_kernel_annihilated :
    b412h * b412null = 0 := by decide +kernel

theorem b412_kernel_left_inverse :
    b412nullFree * b412null = 1 := by decide +kernel

theorem b412_kernel_complete :
    b412null * b412nullFree + b412nullSplit * b412h = 1 := by decide +kernel

theorem b412_kernel_preserved :
    b412E * b412null = 0 := by decide +kernel

theorem b412_comparison_positive :
    (TorusLean.M2.complexify b412comparison).PosSemidef := by
  rw [b412_comparison_reconstruction]
  exact TorusLean.M2.rationalPSDCheck_sound _ _ _ b412_factor_acceptance

theorem b412_relative_exact (v : Fin 34 → ℚ) :
    b412lower *ᵥ v = 0 ↔ ∃ x : Fin 7 → ℚ, b412relative *ᵥ x = v :=
  kernel_from_split b412lower b412relative b412free b412split
    b412_relative_annihilated b412_relative_complete v

theorem b412_zero_kernel_preserved (v : Fin 7 → ℚ)
    (hv : b412h *ᵥ v = 0) : b412comparison *ᵥ v = 0 := by
  rw [b412_comparison_reconstruction]
  exact kernel_preserved_from_split b412h b412E b412null
    b412nullFree b412nullSplit b412_kernel_complete
    b412_kernel_preserved v hv

