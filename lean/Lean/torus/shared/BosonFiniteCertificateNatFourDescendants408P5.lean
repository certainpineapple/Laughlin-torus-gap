  have hD : natFourIntegerMatrix 210 f408desc5IntegerCoordinates=f408desc5 := by
    ext a b
    exact natFourRationalEntryCheck_sound (natFourIntegerMatrix 210 f408desc5IntegerCoordinates) (f408desc5) (by decide +kernel) a b
  have hV : f408desc5IntegerCoordinatesᵀ*f413rawInteger=f408desc5IntegerLeftProduct := by
    ext a b
    fin_cases a
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 39) => (f408desc5IntegerCoordinatesᵀ*f413rawInteger) 0 j)
        (fun (_ : Fin 1) (j : Fin 39) => (f408desc5IntegerLeftProduct) 0 j) (by decide +kernel)
      exact congrFun (congrFun h 0) b
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 39) => (f408desc5IntegerCoordinatesᵀ*f413rawInteger) 1 j)
        (fun (_ : Fin 1) (j : Fin 39) => (f408desc5IntegerLeftProduct) 1 j) (by decide +kernel)
      exact congrFun (congrFun h 0) b
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 39) => (f408desc5IntegerCoordinatesᵀ*f413rawInteger) 2 j)
        (fun (_ : Fin 1) (j : Fin 39) => (f408desc5IntegerLeftProduct) 2 j) (by decide +kernel)
      exact congrFun (congrFun h 0) b
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 39) => (f408desc5IntegerCoordinatesᵀ*f413rawInteger) 3 j)
        (fun (_ : Fin 1) (j : Fin 39) => (f408desc5IntegerLeftProduct) 3 j) (by decide +kernel)
      exact congrFun (congrFun h 0) b
  have hY : f408desc5IntegerLeftProduct*f408desc5IntegerCoordinates=f408desc5IntegerForm := by
    ext a b
    fin_cases a
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 4) => (f408desc5IntegerLeftProduct*f408desc5IntegerCoordinates) 0 j)
        (fun (_ : Fin 1) (j : Fin 4) => (f408desc5IntegerForm) 0 j) (by decide +kernel)
