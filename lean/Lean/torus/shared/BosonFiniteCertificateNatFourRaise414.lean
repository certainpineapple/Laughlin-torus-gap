theorem f414_rational_raise_check : ∀ a : Fin 47,
    natFourRationalRaiseWord (f414basis a) =
      ∑ b : Fin 54, f414raise b a • (wordPolynomial (f415basis b) : Core ℕ ℚ) := by
  have hc : ∀ b a, (f414raiseNat b a : ℚ)=f414raise b a :=
    f414_raise_nat_cast
  have hp : ∀ a : Fin 47, (natFourExpandedWords ((raisedWordsNat (f414basis a)).map fun w => (1,w))).Perm
      (natFourExpandedWords (List.ofFn fun b => (f414raiseNat b a,f415basis b))) := by
    intro a
    simp only [natFourExpandedWords,natFourSortedWord,List.mergeSort_eq_insertionSort]
    fin_cases a <;> decide +kernel
  intro a
  simpa only [hc] using natFour_raise_rational_of_expanded_perm
    (f414basis a) f415basis (fun b => f414raiseNat b a) (hp a)

theorem f414_actual_raise_word (a : Fin 47) :
    canonicalCOMRaiseNat (scaledWord factorialRootNat (f414basis a)) =
      ∑ b : Fin 54, (f414raise b a : ℂ) • scaledWord factorialRootNat (f415basis b) :=
  natFour_raise_action_of_rational_check (f414basis a) f415basis
    (fun b => f414raise b a) (f414_rational_raise_check a)

theorem f414_actual_raise_block (v : Fin 47 → ℂ) :
    canonicalCOMRaiseNat (natFourWordBlock f414basis v) =
      natFourWordBlock f415basis (complexify f414raise *ᵥ v) :=
  natFourWordBlock_rect_action f414basis f415basis canonicalCOMRaiseNat
    (complexify f414raise) f414_actual_raise_word v

