/-- The original relative-column label, including its precise dependent fiber. -/
def k306COMLabel9 (i : Fin 7) : NatCOMRelativeLabel :=
  ⟨k306COMRelativeDegree i,(k306COMIndexLabel i).2⟩

private theorem k306_COM_gram_labelled_rat :
    k306COMBasisᵀ * k306fullGram * k306COMBasis =
      fun i j => natCOMDescendantGramEntry 6 (k306COMLabel9 i) (k306COMLabel9 j) := by
  decide +kernel

private theorem k306_COM_dual_labelled_rat :
    k306COMBasisInverse * p306Ginv * k306COMBasisInverseᵀ =
      fun i j => natCOMDescendantDualEntry 6 (k306COMLabel9 i) (k306COMLabel9 j) := by
  decide +kernel

/-- True Gram block scales are 3^n n!, with no normalization of the source family. -/
theorem k306_COM_gram_labelled :
    k306COMGram = complexify
      (fun i j => natCOMDescendantGramEntry 6 (k306COMLabel9 i) (k306COMLabel9 j)) := by
  unfold k306COMGram
  rw [← complexify_transpose_rect,← complexify_mul_rect,← complexify_mul_rect,
    k306_COM_gram_labelled_rat]

/-- The true inverse Gram has inverse 3^n n! scales on the original relative duals. -/
theorem k306_COM_dual_labelled :
    k306COMGramInverse = complexify
      (fun i j => natCOMDescendantDualEntry 6 (k306COMLabel9 i) (k306COMLabel9 j)) := by
  unfold k306COMGramInverse
  rw [← complexify_transpose_rect,← complexify_mul_rect,← complexify_mul_rect,
    k306_COM_dual_labelled_rat]

/-- Rational coordinates of the genuine rank coefficient, retaining the full source matrix. -/
def k306COMRankCoefficientRat : Matrix (Fin 7) (Fin 7) ℚ :=
  (k306COMBasisInverse * p306Ginv * k306COMBasisInverseᵀ) *
    (k306COMBasisᵀ * p306Mform * k306COMBasis) *
    (k306COMBasisInverse * p306Ginv * k306COMBasisInverseᵀ)

theorem k306_COM_rank_coefficient_rat :
    k306COMRankCoefficient = complexify k306COMRankCoefficientRat := by
  simp only [k306COMRankCoefficient,k306COMRankCoefficientRat,inverseGramCoefficient,
    k306COMGramInverse,k306COMSourceForm,k306_actual_M3_reconstructed,
    complexify_mul_rect,complexify_transpose_rect]

