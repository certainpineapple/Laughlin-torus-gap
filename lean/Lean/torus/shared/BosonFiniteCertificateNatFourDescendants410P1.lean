theorem f410desc1_compression_check :
    f410desc1ᵀ*f411rawM4Form*f410desc1=f410desc1Form := by
  have hD : natFourIntegerMatrix 1260 f410desc1IntegerCoordinates=f410desc1 := by
    ext a b
    exact natFourRationalEntryCheck_sound (natFourIntegerMatrix 1260 f410desc1IntegerCoordinates) (f410desc1) (by decide +kernel) a b
  have hV : f410desc1IntegerCoordinatesᵀ*f411rawInteger=f410desc1IntegerLeftProduct := by
    ext a b
    fin_cases a
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 27) => (f410desc1IntegerCoordinatesᵀ*f411rawInteger) 0 j)
        (fun (_ : Fin 1) (j : Fin 27) => (f410desc1IntegerLeftProduct) 0 j) (by decide +kernel)
      exact congrFun (congrFun h 0) b
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 27) => (f410desc1IntegerCoordinatesᵀ*f411rawInteger) 1 j)
        (fun (_ : Fin 1) (j : Fin 27) => (f410desc1IntegerLeftProduct) 1 j) (by decide +kernel)
      exact congrFun (congrFun h 0) b
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 27) => (f410desc1IntegerCoordinatesᵀ*f411rawInteger) 2 j)
        (fun (_ : Fin 1) (j : Fin 27) => (f410desc1IntegerLeftProduct) 2 j) (by decide +kernel)
      exact congrFun (congrFun h 0) b
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 27) => (f410desc1IntegerCoordinatesᵀ*f411rawInteger) 3 j)
        (fun (_ : Fin 1) (j : Fin 27) => (f410desc1IntegerLeftProduct) 3 j) (by decide +kernel)
      exact congrFun (congrFun h 0) b
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 27) => (f410desc1IntegerCoordinatesᵀ*f411rawInteger) 4 j)
        (fun (_ : Fin 1) (j : Fin 27) => (f410desc1IntegerLeftProduct) 4 j) (by decide +kernel)
      exact congrFun (congrFun h 0) b
  have hY : f410desc1IntegerLeftProduct*f410desc1IntegerCoordinates=f410desc1IntegerForm := by
    ext a b
    fin_cases a
    · have h := natFourIntegerEntryCheck_sound
        (fun (_ : Fin 1) (j : Fin 5) => (f410desc1IntegerLeftProduct*f410desc1IntegerCoordinates) 0 j)
        (fun (_ : Fin 1) (j : Fin 5) => (f410desc1IntegerForm) 0 j) (by decide +kernel)
