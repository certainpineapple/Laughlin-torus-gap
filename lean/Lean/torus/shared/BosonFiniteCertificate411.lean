  exact TorusLean.M2.rationalPSDCheck_sound _ _ _ b411_factor_acceptance

theorem b411_relative_exact (v : Fin 27 → ℚ) :
    b411lower *ᵥ v = 0 ↔ ∃ x : Fin 4 → ℚ, b411relative *ᵥ x = v :=
  kernel_from_split b411lower b411relative b411free b411split
    b411_relative_annihilated b411_relative_complete v

theorem b411_zero_kernel_preserved (v : Fin 4 → ℚ)
    (hv : b411h *ᵥ v = 0) : b411comparison *ᵥ v = 0 := by
  rw [b411_comparison_reconstruction]
  exact kernel_preserved_from_split b411h b411E b411null
    b411nullFree b411nullSplit b411_kernel_complete
    b411_kernel_preserved v hv

