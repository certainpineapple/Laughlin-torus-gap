def b416comparison : Matrix (Fin 10) (Fin 10) ℚ :=
  (alpha) • b416s - b416average + delta • b416h

theorem b416_comparison_reconstruction :
    b416comparison = b416E := by decide +kernel

theorem b416_factor_acceptance :
    TorusLean.M2.rationalPSDCheck b416E b416L b416pivots = true := by decide +kernel

theorem b416_hamiltonian_factor_acceptance :
    TorusLean.M2.rationalPSDCheck b416h b416hL b416hPivots = true := by decide +kernel

theorem b416_relative_annihilated :
    b416lower * b416relative = 0 := by decide +kernel

theorem b416_relative_left_inverse :
    b416free * b416relative = 1 := by decide +kernel

theorem b416_relative_complete :
    b416relative * b416free + b416split * b416lower = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;> decide +kernel

theorem b416_kernel_annihilated :
    b416h * b416null = 0 := by decide +kernel

theorem b416_kernel_left_inverse :
    b416nullFree * b416null = 1 := by decide +kernel

theorem b416_kernel_complete :
    b416null * b416nullFree + b416nullSplit * b416h = 1 := by decide +kernel

theorem b416_kernel_preserved :
    b416E * b416null = 0 := by decide +kernel

theorem b416_comparison_positive :
    (TorusLean.M2.complexify b416comparison).PosSemidef := by
  rw [b416_comparison_reconstruction]
  exact TorusLean.M2.rationalPSDCheck_sound _ _ _ b416_factor_acceptance

theorem b416_relative_exact (v : Fin 64 → ℚ) :
    b416lower *ᵥ v = 0 ↔ ∃ x : Fin 10 → ℚ, b416relative *ᵥ x = v :=
  kernel_from_split b416lower b416relative b416free b416split
    b416_relative_annihilated b416_relative_complete v

theorem b416_zero_kernel_preserved (v : Fin 10 → ℚ)
    (hv : b416h *ᵥ v = 0) : b416comparison *ᵥ v = 0 := by
  rw [b416_comparison_reconstruction]
  exact kernel_preserved_from_split b416h b416E b416null
    b416nullFree b416nullSplit b416_kernel_complete
    b416_kernel_preserved v hv

