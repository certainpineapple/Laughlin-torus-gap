private theorem uTable_correct (z T : Fin 24) (p : Fin 9) :
    evalU 1 z.val T.val p.val = uTable z T p := by
  fin_cases z
  · exact uTableRow00 T p
  · exact uTableRow01 T p
  · exact uTableRow02 T p
  · exact uTableRow03 T p
  · exact uTableRow04 T p
  · exact uTableRow05 T p
  · exact uTableRow06 T p
  · exact uTableRow07 T p
  · exact uTableRow08 T p
  · exact uTableRow09 T p
  · exact uTableRow10 T p
  · exact uTableRow11 T p
  · exact uTableRow12 T p
  · exact uTableRow13 T p
  · exact uTableRow14 T p
  · exact uTableRow15 T p
  · exact uTableRow16 T p
  · exact uTableRow17 T p
  · exact uTableRow18 T p
  · exact uTableRow19 T p
  · exact uTableRow20 T p
  · exact uTableRow21 T p
  · exact uTableRow22 T p
  · exact uTableRow23 T p

def lookupU (z T p : ℕ) : ℤ :=
  if h : z < 24 ∧ T < 24 ∧ p < 9 then
    uTable ⟨z, h.1⟩ ⟨T, h.2.1⟩ ⟨p, h.2.2⟩
  else OAI.Laughlin.Certificate.U 1 z T p

theorem U1_eq_lookupU (z T p : ℕ) :
    OAI.Laughlin.Certificate.U 1 z T p = lookupU z T p := by
  unfold lookupU
  split_ifs with h
  · rw [U_eq_evalU]
    exact uTable_correct ⟨z, h.1⟩ ⟨T, h.2.1⟩ ⟨p, h.2.2⟩
  · rfl

def lookupV (r D T p j k : ℕ) : ℤ :=
  if r ≤ j+k then lookupU r (j+k) j * lookupU (D-r) (T-r) p else 0

private theorem V_eq_lookupV (r D T p j k : ℕ) :
    OAI.Laughlin.Certificate.V r D T p j k = lookupV r D T p j k := by
  simp only [OAI.Laughlin.Certificate.V, lookupV, U1_eq_lookupU]

def lookupEntry (D r s t : ℕ) (e f : ℕ × ℕ × ℤ) : ℚ :=
  let (p,j,a) := e
  let (q,l,b) := f
  let i := p+j-t
  let k := q+l-t
  let T := p+j+k
  if D ≤ T then
    (a : ℚ) * (b : ℚ) * (lookupV r D T p j k : ℚ) * (lookupV s D T q l i : ℚ) *
    (2 : ℚ) ^ (1-2*(T : ℤ)+(p : ℤ)+(q : ℤ)-(t : ℤ)+((r+s)/2 : ℕ)) *
    ((i.factorial : ℚ) * (k.factorial : ℚ) * (t.factorial : ℚ) /
      ((T-D).factorial : ℚ))
  else 0

private theorem yEntry_eq_lookupEntry (D r s t : ℕ) (e f : ℕ × ℕ × ℤ) :
    OAI.Laughlin.Certificate.yEntry D r s t e f = lookupEntry D r s t e f := by
  simp only [OAI.Laughlin.Certificate.yEntry, lookupEntry, V_eq_lookupV]

def lookupRow (D r s : ℕ) (row : ℕ × ℤ × List (ℕ × ℕ × ℤ)) : ℚ :=
  (row.2.2.map (fun e => (row.2.2.map (fun f => lookupEntry D r s row.1 e f)).sum)).sum

theorem yRow_eq_lookupRow (D r s : ℕ) (row : ℕ × ℤ × List (ℕ × ℕ × ℤ)) :
    OAI.Laughlin.Certificate.yRow D r s row = lookupRow D r s row := by
  simp only [OAI.Laughlin.Certificate.yRow, lookupRow, yEntry_eq_lookupEntry]

#print axioms U1_eq_lookupU
#print axioms yRow_eq_lookupRow
end TorusLean.Shared.FermionLocalJet.FourCoupling.YLookupKernel
