  rw [b410_comparison_reconstruction]
  exact TorusLean.M2.rationalPSDCheck_sound _ _ _ b410_factor_acceptance

theorem b410_relative_exact (v : Fin 23 → ℚ) :
    b410lower *ᵥ v = 0 ↔ ∃ x : Fin 5 → ℚ, b410relative *ᵥ x = v :=
  kernel_from_split b410lower b410relative b410free b410split
    b410_relative_annihilated b410_relative_complete v

theorem b410_zero_kernel_preserved (v : Fin 5 → ℚ)
    (hv : b410h *ᵥ v = 0) : b410comparison *ᵥ v = 0 := by
  rw [b410_comparison_reconstruction]
  exact kernel_preserved_from_split b410h b410E b410null
    b410nullFree b410nullSplit b410_kernel_complete
    b410_kernel_preserved v hv

